# Ignore Credentials
.env

# Ignore the data/exported content leaving the .gitkeep file
data/exported/**/*
!data/exported/.gitkeep
# Ignore the data/raw content leaving the .gitkeep file
data/raw/**/*
!data/raw/.gitkeep
# Ignore the data/curated content leaving the .gitkeep file
data/curated/**/*
!data/curated/.gitkeep
# Ignore the data/staged content leaving the .gitkeep file
data/staged/**/*
!data/staged/.gitkeep

# Entorno Python
.venv/